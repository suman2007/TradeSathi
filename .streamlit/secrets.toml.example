# Local test: copy to .streamlit/secrets.toml (git-ignored).
# Streamlit Cloud: paste the same content into  App -> Settings -> Secrets.

# Optional but recommended on a public URL: the dashboard asks for this password.
app_password = "choose-a-password"

# Keeps holdings, buy list, paper trades and stops across restarts (Streamlit Cloud wipes its disk).
# Leave this whole section out to use plain local files.
[storage]
spreadsheet = "PASTE_THE_GOOGLE_SHEET_ID_OR_URL"   # share the sheet (Editor) with the client_email below

[storage.service_account]                          # paste the fields from the Google service-account JSON key
type = "service_account"
project_id = "..."
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "something@your-project.iam.gserviceaccount.com"
client_id = "..."
token_uri = "https://oauth2.googleapis.com/token"
